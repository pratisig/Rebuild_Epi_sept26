# ============================================================
# MODÈLE DE FICHIER D'IDENTIFIANTS — à copier, pas à engager
# ============================================================
#
#   cp credentials.yaml.example credentials.yaml
#
# puis renseignez les valeurs ci-dessous. Le fichier réel
# `credentials.yaml` ne doit JAMAIS être engagé dans le dépôt :
# il est listé dans .gitignore.
#
# En production, placez-le hors du dépôt et faites-y pointer la
# variable d'environnement :
#
#   export EPI_CREDENTIALS_PATH=/etc/epiprediction/credentials.yaml
#
# ------------------------------------------------------------
# 1. Hacher le mot de passe (ne stockez JAMAIS le mot de passe en clair)
#
#      python -c "import streamlit_authenticator as a; \
#                 print(a.Hasher.hash('votre_mot_de_passe'))"
#
#    La commande affiche un hachage bcrypt de 60 caractères
#    commençant par $2b$12$. Copiez-le intégralement dans le
#    champ `password` ci-dessous.
#
# 2. Générer une clé de cookie aléatoire
#
#      python -c "import secrets; print(secrets.token_hex(32))"
#
#    Copiez le résultat dans le champ `key` ci-dessous.
# ============================================================

credentials:
  usernames:
    admin:
      name: Administrateur
      # Hachage bcrypt obtenu via streamlit_authenticator.Hasher.hash()
      password: "$2b$12$REMPLACEZ_PAR_VOTRE_HACHAGE_BCRYPT"

cookie:
  name: epiprediction_auth
  # Clé aléatoire obtenue via secrets.token_hex(32)
  key: "REMPLACEZ_PAR_UNE_CLE_ALEATOIRE_DE_64_CARACTERES_HEX"
  expiry_days: 1

preauthorized:
  emails: []
